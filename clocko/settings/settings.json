            "defaultValue": "de",
            "group": "Allgemein"
        },
        {
            "id": "timezone",
            "label": "Zeitzone",
            "description": "Gib eine IANA-Zeitzone ein (z. B. America/New_York, Europe/London). Leer lassen, um die lokale Zeit zu verwenden.",
            "type": "timezone",
            "defaultValue": "",
            "group": "Allgemein"
        },
        {
            "id": "font",
            "label": "Schriftart",
            "description": "<a href=\"ms-settings:fonts\">Installierte Schriftarten überprüfen</a>",
            "type": "font",
            "defaultValue": "",
            "group": "Darstellung"
        },
        {
            "id": "textAlignment",
            "label": "Textausrichtung",
            "description": "",
            "type": "select",
            "options": [
                { "value": "left", "label": "Links" },
                { "value": "center", "label": "Zentriert" },
                { "value": "right", "label": "Rechts" }
            ],
            "defaultValue": "center",
            "group": "Darstellung"
        },
        {
            "id": "enableLine1",
            "label": "Zeile 1 aktivieren",
            "description": "Die erste Zeile der Uhr anzeigen",
            "type": "checkbox",
            "defaultValue": true,
            "group": "Darstellung"
        },
        {
            "id": "line1Format",
            "label": "Format",
            "description": "<a href='https://day.js.org/docs/en/display/format' target='_blank'>Klicke hier für Formatierungsoptionen</a>",
            "type": "text",
            "defaultValue": "hh:mm:ss [Uhr]",
            "showIf": "enableLine1",
            "group": "Darstellung"
        },
        {
            "id": "line1FontSize",
            "label": "Schriftgröße",
            "description": "",
            "type": "number",
            "min": 1,
            "max": 120,
            "defaultValue": 50,
            "showIf": "enableLine1",
            "group": "Darstellung"
        },
        {
            "id": "line1FontWeight",
            "label": "Schriftstärke",
            "description": "",
            "type": "select",
            "options": [
                { "value": "100", "label": "Dünn" },
                { "value": "200", "label": "Extra Leicht" },
                { "value": "300", "label": "Leicht" },
                { "value": "400", "label": "Normal" },
                { "value": "500", "label": "Medium" },
                { "value": "600", "label": "Halbfett" },
                { "value": "700", "label": "Fett" },
                { "value": "800", "label": "Extra Fett" },
                { "value": "900", "label": "Schwarz (Besonders Fett)" }
            ],
            "defaultValue": "800",
            "showIf": "enableLine1",
            "group": "Darstellung"
        },
        {
            "id": "line1FontColor",
            "label": "Schriftfarbe",
            "description": "",
            "type": "color",
            "defaultValue": "#ffffff",
            "showIf": "enableLine1",
            "group": "Darstellung"
        },
        {
            "id": "line1FontOpacity",
            "label": "Deckkraft der Schrift",
            "description": "",
            "type": "number",
            "defaultValue": "1",
            "min": 0,
            "max": 1,
            "step": ".01",
            "showIf": "enableLine1",
            "group": "Darstellung"
        },
        {
            "id": "line1TextTransform",
            "label": "Texttransformation",
            "description": "",
            "type": "select",
            "options": [
                { "value": "none", "label": "Normal" },
                { "value": "uppercase", "label": "Großbuchstaben" },
                { "value": "lowercase", "label": "Kleinbuchstaben" },
                { "value": "capitalize", "label": "Wortanfang groß" }
            ],
            "defaultValue": "uppercase",
            "showIf": "enableLine1",
            "group": "Darstellung"
        },
