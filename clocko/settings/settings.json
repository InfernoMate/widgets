                { "value": "sk", "label": "Slovenčina (Slowakisch)" },
                { "value": "es", "label": "Español (Spanisch)" },
                { "value": "sv", "label": "Svenska (Schwedisch)" },
                { "value": "th", "label": "ไทย (Thai)" },
                { "value": "tr", "label": "Türkçe (Türkisch)" },
                { "value": "uk", "label": "Українська (Ukrainisch)" },
                { "value": "vi", "label": "Tiếng Việt (Vietnamesisch)" }
